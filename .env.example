# Hanya untuk `npm run dev` (port 5173). Saat FE disajikan backend (http://localhost:8000), biarkan kosong.
# Simpan sebagai .env.local. Kalau backend tidak menjawab /health, app berjalan dalam mode simulasi.
VITE_API_BASE=
# Contoh: VITE_API_BASE=http://localhost:8000

# Kamera yang dipakai di Live (0, 1, 2, ... sama seperti indeks OpenCV). Bisa diganti juga dari menu di halaman Live.
VITE_CAMERA_INDEX=0
